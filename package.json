{
  "name": "abaco-animatic",
  "version": "0.59.22",
  "private": true,
  "author": "Abaco Animation",
  "license": "Apache-2.0",
  "desktopName": "Scene-0.59.22",
  "description": "Local desktop editor for 3D storyboards and animatics; Blender is required for production and rendering",
  "main": "dist-electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"",
    "build:renderer": "tsc -b && vite build",
    "build:electron": "tsup electron/main.ts electron/preload.ts electron/mcp-cli.ts --format cjs --out-dir dist-electron --external electron --external @receptron/laya",
    "build": "npm run build:renderer && npm run build:electron",
    "test": "vitest run",
    "package:linux": "npm run build && electron-builder --linux AppImage --x64 --publish never",
    "package:mac": "npm run build && electron-builder --mac zip --arm64 --publish never",
    "preview": "vite preview"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@receptron/laya": "^0.1.2",
    "openai": "^5.20.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@react-three/drei": "^10.7.6",
    "@react-three/fiber": "^9.3.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.5.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "electron": "^38.1.2",
    "electron-builder": "^26.0.12",
    "jsdom": "^27.0.0",
    "lucide-react": "^0.544.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "three": "^0.180.0",
    "three-stdlib": "^2.36.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.4",
    "zustand": "^5.0.8"
  },
  "build": {
    "appId": "com.abaco.animatic.jevdraw",
    "productName": "Scene-0.59.22",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/index.html",
      "dist/assets/**/*",
      "dist-electron/**/*",
      "package.json",
      "LICENSE",
      "NOTICE"
    ],
    "asarUnpack": [
      "node_modules/onnxruntime-node/**/*"
    ],
    "linux": {
      "target": "AppImage",
      "category": "Graphics",
      "icon": "build/icon.png",
      "syncDesktopName": true,
      "artifactName": "Scene-${version}-linux-${arch}.${ext}",
      "executableName": "scene",
      "extraResources": [
        {
          "from": "build/scene-mcp-linux",
          "to": "scene-mcp"
        }
      ]
    },
    "mac": {
      "target": "zip",
      "category": "public.app-category.graphics-design",
      "icon": "build/icon.png",
      "artifactName": "Scene-${version}-mac-${arch}.${ext}",
      "extraResources": [
        {
          "from": "vendor/whisper-cpp/whisper-cli-macos-arm64",
          "to": "whisper-cli"
        },
        {
          "from": "vendor/whisper-cpp/LICENSE",
          "to": "whisper-license.txt"
        },
        {
          "from": "build/scene-mcp",
          "to": "scene-mcp"
        }
      ]
    }
  },
  "packageManager": "pnpm@11.19.0"
}
