{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "target": "ES2022"
  },
  "include": [
    "vite.config.ts",
    "electron/**/*.ts",
    "src/domain/schema.ts",
    "src/domain/animation.ts",
    "src/domain/camera-space.ts",
    "src/domain/motion-spec.ts",
    "src/domain/ai-contract.ts",
    "src/domain/versioning.ts",
    "src/domain/animation-handoff.ts",
    "src/domain/direction-presets.ts",
    "src/domain/jev-action.ts",
    "src/domain/direction-planner.ts",
    "src/domain/laya-runtime.ts"
  ]
}
