{
  "name": "abaco-animatic",
  "version": "0.56.7",
  "private": true,
  "author": "Abaco Animation",
  "desktopName": "Abaco Animatic",
  "description": "Editor desktop locale per bozze 3D assistite da GPT-6 Astra e Blender",
  "main": "dist-electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"",
    "build:renderer": "tsc -b && vite build",
    "build:electron": "tsup electron/main.ts electron/preload.ts --format cjs --out-dir dist-electron --external electron",
    "build": "npm run build:renderer && npm run build:electron",
    "test": "vitest run",
    "package:linux": "npm run build && electron-builder --linux AppImage",
    "package:mac": "npm run build && electron-builder --mac zip --arm64",
    "preview": "vite preview"
  },
  "dependencies": {
    "openai": "^5.20.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@react-three/drei": "^10.7.6",
    "@react-three/fiber": "^9.3.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.5.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "electron": "^38.1.2",
    "electron-builder": "^26.0.12",
    "jsdom": "^27.0.0",
    "lucide-react": "^0.544.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "three": "^0.180.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.4",
    "zustand": "^5.0.8"
  },
  "build": {
    "appId": "com.abaco.animatic",
    "productName": "Abaco Animatic",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/index.html",
      "dist/assets/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "linux": {
      "target": "AppImage",
      "category": "Graphics",
      "icon": "build/icon.png",
      "syncDesktopName": true,
      "artifactName": "Abaco-Animatic-${version}.${ext}"
    },
    "mac": {
      "target": "zip",
      "category": "public.app-category.graphics-design",
      "icon": "build/icon.png",
      "artifactName": "Abaco-Animatic-${version}-mac-${arch}.${ext}"
    }
  }
}
