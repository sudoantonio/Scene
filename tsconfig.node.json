{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "target": "ES2022"
  },
  "include": [
    "vite.config.ts",
    "electron/**/*.ts",
    "src/domain/schema.ts",
    "src/domain/animation.ts",
    "src/domain/controller-pose.ts",
    "src/domain/character-motion.ts",
    "src/domain/camera-space.ts",
    "src/domain/motion-spec.ts",
    "src/domain/ai-contract.ts",
    "src/domain/versioning.ts",
    "src/domain/animation-handoff.ts",
    "src/domain/direction-presets.ts",
    "src/domain/jev-action.ts",
    "src/domain/direction-planner.ts",
    "src/domain/laya-runtime.ts",
    "src/domain/direction-integrity.ts",
    "src/domain/bundled-animation-standard.ts",
    "src/domain/media-timeline.ts",
    "src/domain/edited-media.ts",
    "src/domain/text-style.ts"
  ]
}
